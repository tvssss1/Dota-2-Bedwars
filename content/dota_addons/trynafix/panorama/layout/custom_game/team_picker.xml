<root>
    <styles><include src="file://{resources}/styles/custom_game/team_picker.css" /></styles>
    <scripts><include src="file://{resources}/scripts/custom_game/team_picker.js" /></scripts>
    <Panel class="TrynaPickerRoot">
        <Panel class="TrynaPickerBackdrop" />
        <Panel class="TrynaPickerContent" flow-children="down">
            <Panel class="TrynaPickerHeading" flow-children="down">
                <Label class="TrynaPickerEyebrow" text="#team_picker_eyebrow" />
