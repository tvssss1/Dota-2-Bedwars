                    <Button id="TeamCard6" class="TrynaPickerCard TrynaPickerRed" onactivate="TeamPicker.Select(6)">
                        <Panel class="TrynaPickerCardWash" /><Panel class="TrynaPickerCorner TrynaPickerCornerTL" /><Panel class="TrynaPickerCorner TrynaPickerCornerBR" /><Panel class="TrynaPickerColorRail" />
